# Example only. Never commit a real .env file or share secret values.
# The production database must be reachable over TLS from the Render service.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:5500
FRONTEND_ORIGINS=http://127.0.0.1:5500
FRONTEND_SITE_URL=http://127.0.0.1:5500
BACKEND_URL=http://localhost:4000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SUPABASE_SERVICE_ROLE_KEY
SQL_SERVER=REPLACE_SQL_HOSTNAME
SQL_PORT=1433
SQL_DATABASE=Mr10xMail
SQL_USER=REPLACE_SQL_USER
SQL_PASSWORD=REPLACE_SQL_PASSWORD
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
# Existing deployments must keep the existing keys to decrypt old records.
# Both values are exactly 64 hexadecimal characters.
DATA_ENCRYPTION_KEY=REPLACE_EXISTING_64_HEX_KEY
CODE_HASH_KEY=REPLACE_EXISTING_64_HEX_KEY
# Optional integrations. Set only for the providers the owner has authorized.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
POLL_INTERVAL_SECONDS=60
