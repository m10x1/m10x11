<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Netflix Verification System</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <h1>Netflix Verification System</h1>
        <nav>
            <ul>
                <li><a href="#customer-request">Customer Request</a></li>
                <li><a href="#services">Services</a></li>
            </ul>
        </nav>
    </header>

    <section id="customer-request">
        <h2>Customer Request</h2>
        <form id="verification-form">
            <label for="email">Email:</label>
            <input type="email" id="email" name="email" required>
            
            <button type="submit">Request Verification Code</button>
        </form>

        <div id="status-message"></div>
    </section>

    <section id="services">
        <h2>Services</h2>
        <ul>
            <li><a href="#netflix">Netflix</a></li>
            <!-- Add more services as needed -->
        </ul>
        
        <div id="netflix-details" class="service-details">
            <h3>Netflix</h3>
            <p>Select Netflix to request a verification code.</p>
            
            <form id="netflix-request-form">
                <label for="email-netflix">Email:</label>
                <input type="email" id="email-netflix" name="email" required>
                
                <button type="submit">Request Verification Code</button>
            </form>

            <div id="netflix-status-message"></div>
        </div>
    </section>

    <footer>
        <p>&copy; 2026 Netflix Verification System. All rights reserved.</p>
    </footer>

    <!-- Include the script file -->
    <script src="script.js"></script>
</body>
</html>

